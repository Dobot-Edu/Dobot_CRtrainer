*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.mp4
*.avi
*.mkv
*.log
*.tmp

# Unity generated output and machine-local editor state. Keep the verified
# Quest installation package while ignoring any other generated build files.
/quest_unity_app/[Bb]uilds/*
!/quest_unity_app/Builds/DobotVrTeleop.apk
/quest_unity_app/[Ll]ibrary/
/quest_unity_app/[Tt]emp/
/quest_unity_app/[Oo]bj/
/quest_unity_app/[Ll]ogs/
/quest_unity_app/UserSettings/
*.apk
!/quest_unity_app/Builds/DobotVrTeleop.apk

# Editable-install metadata
*.egg-info/

# Local rollback snapshots
/backups/
