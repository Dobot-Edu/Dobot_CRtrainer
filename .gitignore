*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# IDE and operating-system files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Local secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Model/download caches
.cache/
**/.cache/
huggingface/
wandb/

# Collected and converted datasets are local runtime artifacts
